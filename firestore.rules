rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if user is a member of an event. Every subcollection write
    // must include this, including paths granted through payerId, senderId,
    // assigneeId or createdBy: those fields outlive membership, so on their
    // own they would let a removed member keep editing old records.
    function isEventMember(eventId) {
      let event = get(/databases/$(database)/documents/events/$(eventId));
      return request.auth.uid in event.data.memberIds;
    }

    // Events collection
    match /events/{eventId} {
      // Read: only members (memberIds always includes creatorId and adminIds)
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberIds;

      // Create: only through the createEvent callable, with the caller as
      // owner, so nobody can be listed as a member without their own action.
      allow create: if false;

      // Update: admins or creator (client writes: title, description, dates, type, status).
      // Fix 1.A — field-level guard: clients must NOT mutate memberIds, adminIds,
      // or creatorId. Those arrays are gatekept by the dedicated Cloud Functions
      // (promoteToAdmin, demoteAdmin, removeEventMember, joinEvent), which use
      // the Admin SDK and bypass these rules. Without this guard a malicious
      // admin client could escalate other users to admin or eject members
      // outside the audited CF paths.
      allow update: if request.auth != null
        && (resource.data.creatorId == request.auth.uid
            || request.auth.uid in resource.data.adminIds)
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.adminIds == resource.data.adminIds
        && request.resource.data.creatorId == resource.data.creatorId;

      // Delete: only the creator
      allow delete: if request.auth != null
        && resource.data.creatorId == request.auth.uid;

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if request.auth != null && isEventMember(eventId);

        allow create: if request.auth != null
          && isEventMember(eventId)
          && request.resource.data.senderId == request.auth.uid
          // Notices such as `settlement` and `settlement_disputed` are written
          // only by the server, so a member cannot forge one.
          && !('kind' in request.resource.data)
          // Set only by the server, when a sender is over the urgent rate.
          && !('urgentPushSkipped' in request.resource.data)
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000
          // Urgent sending needs `chat.urgent`, which owners and admins hold
          // until permissions land.
          && (request.resource.data.get('isHighPriority', false) != true
              || get(/databases/$(database)/documents/events/$(eventId)).data.creatorId == request.auth.uid
              || request.auth.uid in get(/databases/$(database)/documents/events/$(eventId)).data.adminIds);

        allow delete: if request.auth != null
          && isEventMember(eventId)
          && resource.data.senderId == request.auth.uid;

        allow update: if false;
      }

      // Tasks subcollection
      match /tasks/{taskId} {
        function eventDoc() {
          return get(/databases/$(database)/documents/events/$(eventId)).data;
        }

        allow read: if request.auth != null && isEventMember(eventId);

        // `tasks.manage` and a task's creator may edit it. Owners and admins
        // hold `tasks.manage` until permissions land.
        function canEditTask(task) {
          return eventDoc().creatorId == request.auth.uid
            || request.auth.uid in eventDoc().adminIds
            || task.createdBy == request.auth.uid;
        }

        // markTaskComplete is the only way to finish a task. A client may keep
        // a finished task finished while editing it, or reopen it, which clears
        // who completed it. It can never set or rewrite those fields.
        function completionIsUntouched() {
          let next = request.resource.data;
          let reopening = next.get('status', null) != 'done'
            && next.get('completedAt', null) == null
            && next.get('completedBy', null) == null;
          return (next.get('status', null) != 'done' || resource.data.get('status', null) == 'done')
            && (reopening
                || !next.diff(resource.data).affectedKeys().hasAny(['completedAt', 'completedBy']));
        }

        allow read: if request.auth != null && isEventMember(eventId);

        // Create: any event member; must set themselves as createdBy, and a new
        // task cannot start finished.
        allow create: if request.auth != null
          && isEventMember(eventId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.eventId == eventId
          && request.resource.data.get('status', null) != 'done'
          && request.resource.data.get('completedAt', null) == null
          && request.resource.data.get('completedBy', null) == null;

        // Update: an assignee may change only status. Fix 1.C — clients must
        // NOT mutate eventId or createdBy: eventId pinpoints the parent event,
        // and createdBy records authorship.
        allow update: if request.auth != null
          && isEventMember(eventId)
          && (canEditTask(resource.data)
              || (resource.data.assigneeId == request.auth.uid
                  && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['status', 'completedAt', 'completedBy', 'updatedAt'])))
          && completionIsUntouched()
          && request.resource.data.eventId == resource.data.eventId
          && request.resource.data.createdBy == resource.data.createdBy;

        // Delete: only creator/owner/admin
        allow delete: if request.auth != null
          && isEventMember(eventId)
          && (resource.data.createdBy == request.auth.uid
              || eventDoc().creatorId == request.auth.uid
              || request.auth.uid in eventDoc().adminIds);

        // Checklist items subcollection
        match /checklist/{itemId} {
          allow read: if request.auth != null && isEventMember(eventId);

          allow create, delete: if request.auth != null
            && isEventMember(eventId)
            && (get(/databases/$(database)/documents/events/$(eventId)/tasks/$(taskId)).data.createdBy == request.auth.uid
                || eventDoc().creatorId == request.auth.uid
                || request.auth.uid in eventDoc().adminIds);

          // Update: anyone who can edit the task, or the assignee ticking it off.
          allow update: if request.auth != null
            && isEventMember(eventId)
            && (get(/databases/$(database)/documents/events/$(eventId)/tasks/$(taskId)).data.createdBy == request.auth.uid
                || eventDoc().creatorId == request.auth.uid
                || request.auth.uid in eventDoc().adminIds
                || (get(/databases/$(database)/documents/events/$(eventId)/tasks/$(taskId)).data.assigneeId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['isCompleted', 'updatedAt'])));
        }
      }

      // Expenses subcollection
      match /expenses/{expenseId} {
        function eventDocForExpense() {
          return get(/databases/$(database)/documents/events/$(eventId)).data;
        }

        allow read: if request.auth != null && isEventMember(eventId);

        // Expenses are written by the saveExpense and recordSettlement
        // callables, because rules cannot loop over splits to check they add up.
        allow create, update: if false;

        // Delete: payer, event creator, or any admin.
        allow delete: if request.auth != null
          && isEventMember(eventId)
          && (resource.data.payerId == request.auth.uid
              || eventDocForExpense().creatorId == request.auth.uid
              || request.auth.uid in eventDocForExpense().adminIds);
      }
    }

    // Event invites — managed entirely by Cloud Functions via Admin SDK
    match /event_invites/{code} {
      allow read, write: if false;
    }

    // Users collection
    //
    // Fix 1.B Option A — projection-split. The public users/{uid} doc keeps
    // only display fields visible to every CrewPoint user (displayName,
    // photoUrl, payment* handles, currency). PII fields (email, providerIds,
    // fcmTokens, preferences, createdAt, updatedAt) live in the
    // users/{uid}/private/profile subdoc with self-only access. This
    // eliminates the broad read on PII without touching the
    // co-member-display read path that chat / tasks / budget rely on.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;

      match /private/{docId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }

      // Per-user chat read-state. Powers the global inbox unread badges
      // — `users/{uid}/chatReads/{eventId}` carries `lastReadAt`. Only
      // the owning uid may read/write; other users (even co-event
      // members) have no business seeing when someone last opened a
      // chat. ChatRepository.markEventRead / backfillReadStateForExistingEvents
      // / watchLastRead all go through this path.
      match /chatReads/{eventId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }

      // Per-user, per-event push-notification mute state (Phase 5 V3).
      // `users/{uid}/eventMutes/{eventId}` carries `mutedUntil` (ISO-8601
      // UTC string). Self-only: a user's mute choice is private (it
      // would be a privacy leak if co-event members could see who has
      // an event muted). The server-side CF reads this via the Admin
      // SDK and so bypasses these rules.
      match /eventMutes/{eventId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }
    }
  }
}
