rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The caller's member document (Req 25). Only server code writes it.
    function memberPath(eventId) {
      return /databases/$(database)/documents/events/$(eventId)/members/$(request.auth.uid);
    }

    // Helper: check if user is a member of an event. Every subcollection write
    // must include this, including paths granted through payerId, senderId,
    // assigneeId or createdBy: those fields outlive membership, so on their
    // own they would let a removed member keep editing old records.
    function isEventMember(eventId) {
      return exists(memberPath(eventId));
    }

    // One permission, checked with one member-document read (Req 27).
    function can(eventId, permission) {
      return isEventMember(eventId)
        && permission in get(memberPath(eventId)).data.permissions;
    }

    // Adding your own expense and creating tasks are open to every member
    // except Observer and Vendor, since no permission covers them (Req 34).
    function contributes(eventId) {
      return isEventMember(eventId)
        && !get(memberPath(eventId)).data.roleIds.hasOnly(['observer', 'vendor']);
    }

    function eventData(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data;
    }

    // Archived events are read-only for everyone.
    function isNotArchived(eventId) {
      return eventData(eventId).get('status', 'active') != 'archived';
    }

    // A module is on unless turned off. Reads stay open, and data is kept.
    function isModuleOn(eventId, module) {
      return eventData(eventId).get('modules', {}).get(module, true) != false;
    }

    function canManageEvent(eventId) {
      return can(eventId, 'event.manage');
    }

    // Once an event ends, only `event.manage` can change its tasks. Settlements,
    // expenses and chat stay open.
    function tasksAreOpen(eventId) {
      return isNotArchived(eventId)
        && isModuleOn(eventId, 'tasks')
        && (eventData(eventId).get('status', 'active') != 'ended' || canManageEvent(eventId));
    }

    // Compares with missing treated as null, so older events can be edited.
    function fieldUnchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    function isPositiveIntOrNull(field) {
      let value = request.resource.data.get(field, null);
      return value == null || (value is int && value > 0);
    }

    // Events collection
    match /events/{eventId} {
      // Read: only members. A draft is visible only to `event.manage`. The app
      // finds its events through member documents and reads each one.
      allow get: if request.auth != null
        && isEventMember(eventId)
        && (resource.data.get('status', 'active') != 'draft'
            || can(eventId, 'event.manage'));
      // Kept for app builds older than the cutover, until the arrays go. A list
      // query cannot check drafts, so joining, role changes and moving back to
      // draft all keep plain members out of drafts.
      allow list: if request.auth != null
        && request.auth.uid in resource.data.memberIds;

      // Create: only through the createEvent callable, with the caller as
      // owner, so nobody can be listed as a member without their own action.
      allow create: if false;

      // Update: admins or creator (client writes: title, description, dates, type, status).
      // Fix 1.A — field-level guard: clients must NOT mutate memberIds, adminIds,
      // or creatorId. Those arrays are gatekept by the dedicated Cloud Functions
      // (promoteToAdmin, demoteAdmin, removeEventMember, joinEvent), which use
      // the Admin SDK and bypass these rules. Without this guard a malicious
      // admin client could escalate other users to admin or eject members
      // outside the audited CF paths.
      allow update: if request.auth != null
        && can(eventId, 'event.manage')
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.adminIds == resource.data.adminIds
        && request.resource.data.creatorId == resource.data.creatorId
        // Currency stays fixed once an event holds money, which rules cannot
        // check, so only the changeEventCurrency callable can change it.
        && fieldUnchanged('currency')
        // Choosing a verified organizer would raise the event's limits.
        && fieldUnchanged('organizerId')
        && fieldUnchanged('templateId')
        // Older events keep their type's name as display text only.
        && fieldUnchanged('eventType')
        // Joining relies on this count, so only the server keeps it.
        && fieldUnchanged('memberCount')
        // Archived events only allow a restore, by changing status.
        && (resource.data.get('status', 'active') != 'archived'
            || request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'statusSetAt', 'updatedAt']))
        && (fieldUnchanged('status')
            || (request.resource.data.status in ['draft', 'published', 'live', 'ended', 'archived']
                && request.resource.data.statusSetAt == request.time
                && (request.resource.data.status != 'draft'
                    || request.resource.data.memberIds.hasOnly(
                        request.resource.data.adminIds.concat([request.resource.data.creatorId])))))
        && isPositiveIntOrNull('capacity')
        && isPositiveIntOrNull('memberLimit')
        && (!('timeZone' in request.resource.data) || request.resource.data.timeZone is string)
        && (!('venues' in request.resource.data) || request.resource.data.venues is list)
        && (!('languages' in request.resource.data) || request.resource.data.languages is list)
        && (!('labels' in request.resource.data) || request.resource.data.labels is map)
        && (!('modules' in request.resource.data) || request.resource.data.modules is map);

      // Delete: only the Owner, the one role holding `event.transfer`.
      allow delete: if request.auth != null
        && can(eventId, 'event.transfer');

      // Member documents and the event's roles (Req 25, 27). Only server code
      // writes them, so nobody can grant themselves a permission.
      match /members/{memberId} {
        allow read: if request.auth != null && isEventMember(eventId);
        allow write: if false;
      }

      match /roles/{roleId} {
        allow read: if request.auth != null && isEventMember(eventId);
        allow write: if false;
      }

      // Crews (Req 33). The saveCrew, setCrewMembers and deleteCrew callables
      // write them, keeping crewIds on member documents in step.
      match /crews/{crewId} {
        allow read: if request.auth != null && isEventMember(eventId);
        allow write: if false;
      }

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if request.auth != null && isEventMember(eventId);

        allow create: if request.auth != null
          && can(eventId, 'chat.send')
          && isNotArchived(eventId)
          && isModuleOn(eventId, 'chat')
          && request.resource.data.senderId == request.auth.uid
          // Notices such as `settlement` and `settlement_disputed` are written
          // only by the server, so a member cannot forge one.
          && !('kind' in request.resource.data)
          // Set only by the server, when a sender is over the urgent rate.
          && !('urgentPushSkipped' in request.resource.data)
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000
          // Urgent sending needs `chat.urgent`.
          && (request.resource.data.get('isHighPriority', false) != true
              || can(eventId, 'chat.urgent'));

        allow delete: if request.auth != null
          && isEventMember(eventId)
          && isNotArchived(eventId)
          && isModuleOn(eventId, 'chat')
          && resource.data.senderId == request.auth.uid;

        allow update: if false;
      }

      // Tasks subcollection
      match /tasks/{taskId} {

        allow read: if request.auth != null && isEventMember(eventId);

        // `tasks.manage` and a task's creator may edit it.
        function canEditTask(task) {
          return can(eventId, 'tasks.manage')
            || task.createdBy == request.auth.uid;
        }

        // markTaskComplete is the only way to finish a task. A client may keep
        // a finished task finished while editing it, or reopen it, which clears
        // who completed it. It can never set or rewrite those fields.
        function completionIsUntouched() {
          let next = request.resource.data;
          let reopening = next.get('status', null) != 'done'
            && next.get('completedAt', null) == null
            && next.get('completedBy', null) == null;
          return (next.get('status', null) != 'done' || resource.data.get('status', null) == 'done')
            && (reopening
                || !next.diff(resource.data).affectedKeys().hasAny(['completedAt', 'completedBy']));
        }

        allow read: if request.auth != null && isEventMember(eventId);

        // A task's crew (Req 72) is optional, and must be a crew that exists.
        // An unchanged crew is allowed, so a task whose crew deleteCrew has
        // not cleared yet can still be edited.
        function crewIsValid(before) {
          let crewId = request.resource.data.get('crewId', null);
          return crewId == null
            || crewId == before
            || (crewId is string
                && exists(/databases/$(database)/documents/events/$(eventId)/crews/$(crewId)));
        }

        // Create: any member but Observer and Vendor; must set themselves as
        // createdBy, and a new task cannot start finished.
        allow create: if request.auth != null
          && contributes(eventId)
          && tasksAreOpen(eventId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.eventId == eventId
          && request.resource.data.get('status', null) != 'done'
          && request.resource.data.get('completedAt', null) == null
          && request.resource.data.get('completedBy', null) == null
          && crewIsValid(null);

        // Update: an assignee may change only status. Fix 1.C — clients must
        // NOT mutate eventId or createdBy: eventId pinpoints the parent event,
        // and createdBy records authorship.
        allow update: if request.auth != null
          && isEventMember(eventId)
          && tasksAreOpen(eventId)
          && (canEditTask(resource.data)
              || (resource.data.assigneeId == request.auth.uid
                  && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['status', 'completedAt', 'completedBy', 'updatedAt'])))
          && completionIsUntouched()
          && crewIsValid(resource.data.get('crewId', null))
          && request.resource.data.eventId == resource.data.eventId
          && request.resource.data.createdBy == resource.data.createdBy;

        // Delete: the task's creator, or `tasks.manage`
        allow delete: if request.auth != null
          && isEventMember(eventId)
          && tasksAreOpen(eventId)
          && canEditTask(resource.data);

        // Checklist items subcollection
        match /checklist/{itemId} {
          allow read: if request.auth != null && isEventMember(eventId);

          allow create, delete: if request.auth != null
            && isEventMember(eventId)
            && tasksAreOpen(eventId)
            && canEditTask(get(/databases/$(database)/documents/events/$(eventId)/tasks/$(taskId)).data);

          // Update: anyone who can edit the task, or the assignee ticking it off.
          allow update: if request.auth != null
            && isEventMember(eventId)
            && tasksAreOpen(eventId)
            && (canEditTask(get(/databases/$(database)/documents/events/$(eventId)/tasks/$(taskId)).data)
                || (get(/databases/$(database)/documents/events/$(eventId)/tasks/$(taskId)).data.assigneeId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['isCompleted', 'updatedAt'])));
        }
      }

      // Expenses subcollection
      match /expenses/{expenseId} {

        allow read: if request.auth != null && isEventMember(eventId);

        // Expenses are written by the saveExpense and recordSettlement
        // callables, because rules cannot loop over splits to check they add up.
        allow create, update: if false;

        // Delete: the payer, or `money.record`.
        allow delete: if request.auth != null
          && isEventMember(eventId)
          && isNotArchived(eventId)
          && isModuleOn(eventId, 'budget')
          && (resource.data.payerId == request.auth.uid
              || can(eventId, 'money.record'));
      }
    }

    // "My events" (Req 25): a collection-group query on member documents.
    // Anyone may read their own, in any event.
    match /{path=**}/members/{memberId} {
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // Event invites — managed entirely by Cloud Functions via Admin SDK
    // Written only by the server, so nobody can verify themselves.
    match /organizers/{organizerId} {
      allow read: if request.auth != null
        && request.auth.uid == resource.data.ownerId;
      allow write: if false;
    }

    // App config, such as the minimum app version. Read before sign-in, so
    // it is public. Changed only from the console or the Admin SDK.
    match /config/app {
      allow read: if true;
      allow write: if false;
    }

    match /event_invites/{code} {
      allow read, write: if false;
    }

    // Users collection
    //
    // Fix 1.B Option A — projection-split. The public users/{uid} doc keeps
    // only display fields visible to every CrewPoint user (displayName,
    // photoUrl, payment* handles, currency). PII fields (email, providerIds,
    // fcmTokens, preferences, createdAt, updatedAt) live in the
    // users/{uid}/private/profile subdoc with self-only access. This
    // eliminates the broad read on PII without touching the
    // co-member-display read path that chat / tasks / budget rely on.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;

      match /private/{docId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }

      // Per-user chat read-state. Powers the global inbox unread badges
      // — `users/{uid}/chatReads/{eventId}` carries `lastReadAt`. Only
      // the owning uid may read/write; other users (even co-event
      // members) have no business seeing when someone last opened a
      // chat. ChatRepository.markEventRead / backfillReadStateForExistingEvents
      // / watchLastRead all go through this path.
      match /chatReads/{eventId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }

      // Per-user, per-event push-notification mute state (Phase 5 V3).
      // `users/{uid}/eventMutes/{eventId}` carries `mutedUntil` (ISO-8601
      // UTC string). Self-only: a user's mute choice is private (it
      // would be a privacy leak if co-event members could see who has
      // an event muted). The server-side CF reads this via the Admin
      // SDK and so bypasses these rules.
      match /eventMutes/{eventId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }
    }
  }
}
