rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The caller's member document (Req 25). Only server code writes it.
    function memberPath(eventId) {
      return /databases/$(database)/documents/events/$(eventId)/members/$(request.auth.uid);
    }

    // Helper: check if user is a member of an event. Every subcollection write
    // must include this, including paths granted through payerId, senderId,
    // assigneeId or createdBy: those fields outlive membership, so on their
    // own they would let a removed member keep editing old records.
    function isEventMember(eventId) {
      return exists(memberPath(eventId));
    }

    // One permission, checked with one member-document read (Req 27).
    function can(eventId, permission) {
      return isEventMember(eventId)
        && permission in get(memberPath(eventId)).data.permissions;
    }

    // Adding your own expense and creating tasks are open to every member
    // except Observer and Vendor, since no permission covers them (Req 34).
    function contributes(eventId) {
      return isEventMember(eventId)
        && !get(memberPath(eventId)).data.roleIds.hasOnly(['observer', 'vendor']);
    }

    // Vendors and Observers read only tasks assigned to them, unless their
    // role is given `tasks.manage` (Req 32). A list query must filter on
    // `assigneeId` for them.
    function readsTask(eventId, task) {
      return contributes(eventId)
        || can(eventId, 'tasks.manage')
        || task.get('assigneeId', null) == request.auth.uid;
    }

    // Whether the caller is a linked adult of [groupId] (Req 26b), from the
    // group IDs on their member document.
    function inMyGroup(eventId, groupId) {
      return groupId != null
        && isEventMember(eventId)
        && groupId in get(memberPath(eventId)).data.get('groupIds', []);
    }

    // Adding or editing a participant, children included: `participants.edit`,
    // or a linked adult for their own group (Req 40).
    function editsParticipant(eventId, groupId) {
      return can(eventId, 'participants.edit')
        || (can(eventId, 'group.editOwn') && inMyGroup(eventId, groupId));
    }

    // Custom field answers (Req 41): a map of at most 100, and the filter
    // tags the roster queries by, worked out by the app from standard
    // answers. Private answers are never tagged.
    function answersAreValid(data) {
      return (!('fields' in data) || (data.fields is map && data.fields.size() <= 100))
        && (!('filterTags' in data)
            || (data.filterTags is list && data.filterTags.size() <= 200));
    }

    function eventData(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data;
    }

    // Archived events are read-only for everyone.
    function isNotArchived(eventId) {
      return eventData(eventId).get('status', 'active') != 'archived';
    }

    // A module is on unless turned off. Reads stay open, and data is kept.
    function isModuleOn(eventId, module) {
      return eventData(eventId).get('modules', {}).get(module, true) != false;
    }

    function canManageEvent(eventId) {
      return can(eventId, 'event.manage');
    }

    // Once an event ends, only `event.manage` can change its tasks. Settlements,
    // expenses and chat stay open.
    function tasksAreOpen(eventId) {
      return isNotArchived(eventId)
        && isModuleOn(eventId, 'tasks')
        && (eventData(eventId).get('status', 'active') != 'ended' || canManageEvent(eventId));
    }

    // Compares with missing treated as null, so older events can be edited.
    function fieldUnchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    function isPositiveIntOrNull(field) {
      let value = request.resource.data.get(field, null);
      return value == null || (value is int && value > 0);
    }

    // Events collection
    match /events/{eventId} {
      // Read: only members. A draft is visible only to `event.manage`. The app
      // finds its events through member documents and reads each one.
      allow get: if request.auth != null
        && isEventMember(eventId)
        && (resource.data.get('status', 'active') != 'draft'
            || can(eventId, 'event.manage'));
      // Kept for app builds older than the cutover, until the arrays go. A list
      // query cannot check drafts, so joining, role changes and moving back to
      // draft all keep plain members out of drafts.
      allow list: if request.auth != null
        && request.auth.uid in resource.data.memberIds;

      // Create: only through the createEvent callable, with the caller as
      // owner, so nobody can be listed as a member without their own action.
      allow create: if false;

      // Update: admins or creator (client writes: title, description, dates, type, status).
      // Fix 1.A — field-level guard: clients must NOT mutate memberIds, adminIds,
      // or creatorId. Those arrays are gatekept by the dedicated Cloud Functions
      // (promoteToAdmin, demoteAdmin, removeEventMember, joinEvent), which use
      // the Admin SDK and bypass these rules. Without this guard a malicious
      // admin client could escalate other users to admin or eject members
      // outside the audited CF paths.
      allow update: if request.auth != null
        && can(eventId, 'event.manage')
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.adminIds == resource.data.adminIds
        && request.resource.data.creatorId == resource.data.creatorId
        // Currency stays fixed once an event holds money, which rules cannot
        // check, so only the changeEventCurrency callable can change it.
        && fieldUnchanged('currency')
        // Choosing a verified organizer would raise the event's limits.
        && fieldUnchanged('organizerId')
        && fieldUnchanged('templateId')
        // Older events keep their type's name as display text only.
        && fieldUnchanged('eventType')
        // Joining relies on this count, so only the server keeps it.
        && fieldUnchanged('memberCount')
        // Expense access is copied onto member documents, so only the
        // setExpenseAccess callable changes it (Req 38).
        && request.resource.data.get('settings', {}).get('expenseAccess', null)
            == resource.data.get('settings', {}).get('expenseAccess', null)
        // Archived events only allow a restore, by changing status.
        && (resource.data.get('status', 'active') != 'archived'
            || request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'statusSetAt', 'updatedAt']))
        && (fieldUnchanged('status')
            || (request.resource.data.status in ['draft', 'published', 'live', 'ended', 'archived']
                && request.resource.data.statusSetAt == request.time
                && (request.resource.data.status != 'draft'
                    || request.resource.data.memberIds.hasOnly(
                        request.resource.data.adminIds.concat([request.resource.data.creatorId])))))
        && isPositiveIntOrNull('capacity')
        && isPositiveIntOrNull('memberLimit')
        && (!('timeZone' in request.resource.data) || request.resource.data.timeZone is string)
        && (!('venues' in request.resource.data) || request.resource.data.venues is list)
        && (!('languages' in request.resource.data) || request.resource.data.languages is list)
        && (!('labels' in request.resource.data) || request.resource.data.labels is map)
        && (!('modules' in request.resource.data) || request.resource.data.modules is map);

      // Delete: only the Owner, the one role holding `event.transfer`.
      allow delete: if request.auth != null
        && can(eventId, 'event.transfer');

      // Member documents and the event's roles (Req 25, 27). Only server code
      // writes them, so nobody can grant themselves a permission.
      match /members/{memberId} {
        allow read: if request.auth != null && isEventMember(eventId);
        allow write: if false;
      }

      match /roles/{roleId} {
        allow read: if request.auth != null && isEventMember(eventId);
        allow write: if false;
      }

      // A pending ownership offer (Req 30). The person offered reads it to
      // accept; only the ownership callables write it.
      // Changes to event settings, with who made them and when (Req 38b).
      // Only the server writes it.
      match /settingsLog/{entryId} {
        allow read: if request.auth != null && can(eventId, 'event.manage');
        allow write: if false;
      }

      match /ownership/{docId} {
        allow read: if request.auth != null && isEventMember(eventId);
        allow write: if false;
      }

      // Crews (Req 33). The saveCrew, setCrewMembers and deleteCrew callables
      // write them, keeping crewIds on member documents in step.
      match /crews/{crewId} {
        allow read: if request.auth != null && isEventMember(eventId);
        allow write: if false;
      }

      // Messages subcollection
      match /messages/{messageId} {
        // Reading chat needs `chat.send`, so a Vendor or Observer has no chat
        // unless the Owner adds it to their role (Req 32).
        allow read: if request.auth != null && can(eventId, 'chat.send');

        allow create: if request.auth != null
          && can(eventId, 'chat.send')
          && isNotArchived(eventId)
          && isModuleOn(eventId, 'chat')
          && request.resource.data.senderId == request.auth.uid
          // Notices such as `settlement` and `settlement_disputed` are written
          // only by the server, so a member cannot forge one.
          && !('kind' in request.resource.data)
          // Set only by the server, when a sender is over the urgent rate.
          && !('urgentPushSkipped' in request.resource.data)
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000
          // Urgent sending needs `chat.urgent`.
          && (request.resource.data.get('isHighPriority', false) != true
              || can(eventId, 'chat.urgent'));

        allow delete: if request.auth != null
          && isEventMember(eventId)
          && isNotArchived(eventId)
          && isModuleOn(eventId, 'chat')
          && resource.data.senderId == request.auth.uid;

        allow update: if false;
      }

      // Tasks subcollection
      match /tasks/{taskId} {

        allow read: if request.auth != null && readsTask(eventId, resource.data);

        // `tasks.manage` and a task's creator may edit it.
        function canEditTask(task) {
          return can(eventId, 'tasks.manage')
            || task.createdBy == request.auth.uid;
        }

        // markTaskComplete is the only way to finish a task. A client may keep
        // a finished task finished while editing it, or reopen it, which clears
        // who completed it. It can never set or rewrite those fields.
        function completionIsUntouched() {
          let next = request.resource.data;
          let reopening = next.get('status', null) != 'done'
            && next.get('completedAt', null) == null
            && next.get('completedBy', null) == null;
          return (next.get('status', null) != 'done' || resource.data.get('status', null) == 'done')
            && (reopening
                || !next.diff(resource.data).affectedKeys().hasAny(['completedAt', 'completedBy']));
        }

        // A task's crew (Req 72) is optional, and must be a crew that exists.
        // An unchanged crew is allowed, so a task whose crew deleteCrew has
        // not cleared yet can still be edited.
        function crewIsValid(before) {
          let crewId = request.resource.data.get('crewId', null);
          return crewId == null
            || crewId == before
            || (crewId is string
                && exists(/databases/$(database)/documents/events/$(eventId)/crews/$(crewId)));
        }

        // A task's budget figure lives in `taskBudgets` (Req 36). Older apps
        // still send an empty one, which is allowed so they can save tasks.
        function budgetIsNotOnTask() {
          return request.resource.data.get('budgetEstimate', null) == null;
        }

        // Create: any member but Observer and Vendor; must set themselves as
        // createdBy, and a new task cannot start finished.
        allow create: if request.auth != null
          && contributes(eventId)
          && tasksAreOpen(eventId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.eventId == eventId
          && request.resource.data.get('status', null) != 'done'
          && request.resource.data.get('completedAt', null) == null
          && request.resource.data.get('completedBy', null) == null
          && budgetIsNotOnTask()
          && crewIsValid(null);

        // Update: an assignee may change only status. Fix 1.C — clients must
        // NOT mutate eventId or createdBy: eventId pinpoints the parent event,
        // and createdBy records authorship.
        allow update: if request.auth != null
          && isEventMember(eventId)
          && tasksAreOpen(eventId)
          && (canEditTask(resource.data)
              || (resource.data.assigneeId == request.auth.uid
                  && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['status', 'completedAt', 'completedBy', 'updatedAt'])))
          && completionIsUntouched()
          && budgetIsNotOnTask()
          && crewIsValid(resource.data.get('crewId', null))
          && request.resource.data.eventId == resource.data.eventId
          && request.resource.data.createdBy == resource.data.createdBy;

        // Delete: the task's creator, or `tasks.manage`
        allow delete: if request.auth != null
          && isEventMember(eventId)
          && tasksAreOpen(eventId)
          && canEditTask(resource.data);

        // Checklist items subcollection
        match /checklist/{itemId} {
          allow read: if request.auth != null
            && readsTask(eventId, get(/databases/$(database)/documents/events/$(eventId)/tasks/$(taskId)).data);

          allow create, delete: if request.auth != null
            && isEventMember(eventId)
            && tasksAreOpen(eventId)
            && canEditTask(get(/databases/$(database)/documents/events/$(eventId)/tasks/$(taskId)).data);

          // Update: anyone who can edit the task, or the assignee ticking it off.
          allow update: if request.auth != null
            && isEventMember(eventId)
            && tasksAreOpen(eventId)
            && (canEditTask(get(/databases/$(database)/documents/events/$(eventId)/tasks/$(taskId)).data)
                || (get(/databases/$(database)/documents/events/$(eventId)/tasks/$(taskId)).data.assigneeId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['isCompleted', 'updatedAt'])));
        }
      }

      // A task's budget figure (Req 36), apart from the task because rules
      // cannot hide one field (Technical Decision 4). Reading needs
      // `budget.read`, and setting or clearing it `budget.edit`.
      match /taskBudgets/{taskId} {
        allow read: if request.auth != null && can(eventId, 'budget.read');

        allow create, update: if request.auth != null
          && can(eventId, 'budget.edit')
          && tasksAreOpen(eventId)
          // After the write, so a new task and its figure save together.
          && existsAfter(/databases/$(database)/documents/events/$(eventId)/tasks/$(taskId))
          && request.resource.data.keys().hasOnly(['estimate', 'updatedBy', 'updatedAt'])
          && request.resource.data.estimate is number
          && request.resource.data.estimate >= 0
          && request.resource.data.updatedBy == request.auth.uid;

        allow delete: if request.auth != null
          && can(eventId, 'budget.edit')
          && tasksAreOpen(eventId);
      }

      // Groups of participants (Req 40). The roster needs
      // `participants.read`, and a linked adult reads their own group. The
      // saveGroup, setGroupAdults and deleteGroup callables write them.
      match /groups/{groupId} {
        allow read: if request.auth != null
          && (can(eventId, 'participants.read') || inMyGroup(eventId, groupId));
        // Only a group's custom field answers are written here (Req 41).
        // Its name and adults go through the group callables.
        allow update: if request.auth != null
          && isNotArchived(eventId)
          && editsParticipant(eventId, groupId)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['fields', 'filterTags', 'updatedAt'])
          && answersAreValid(request.resource.data);
        allow create, delete: if false;

        // A group's private answers, like a participant's.
        match /private/{docId} {
          allow read: if request.auth != null
            && (can(eventId, 'participants.readPrivate') || inMyGroup(eventId, groupId));
          allow write: if request.auth != null
            && isNotArchived(eventId)
            && editsParticipant(eventId, groupId)
            && (request.resource == null
                || (request.resource.data.keys().hasOnly(['fields', 'updatedAt'])
                    && answersAreValid(request.resource.data)));
        }
      }

      // Ambiguous account links waiting for an organizer (Req 46). They show
      // the person's email, so reading needs `participants.readPrivate`;
      // linkMyParticipants and resolveLinkRequest write them.
      match /linkRequests/{uid} {
        allow read: if request.auth != null && can(eventId, 'participants.readPrivate');
        allow write: if false;
      }

      // Scrambled match keys of unnamed entries a deleted account left (Req
      // 14a). Only the server reads them.
      match /participantKeys/{participantId} {
        allow read, write: if false;
      }

      // Roster import jobs (Req 44a, 75). Someone with `participants.import`
      // queues a check; once it is checked, they queue it again to apply.
      // The onImportQueued function writes everything else, so a job can be
      // left and reopened.
      match /imports/{jobId} {
        allow read: if request.auth != null && can(eventId, 'participants.import');
        allow create: if request.auth != null
          && can(eventId, 'participants.import')
          && isNotArchived(eventId)
          && request.resource.data.keys().hasOnly(
              ['fileName', 'targets', 'header', 'mode', 'status', 'createdBy', 'createdAt'])
          && request.resource.data.status == 'queued'
          && request.resource.data.mode in ['dryRun', 'apply']
          && request.resource.data.targets is list
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if request.auth != null
          && can(eventId, 'participants.import')
          && isNotArchived(eventId)
          && resource.data.status == 'checked'
          && request.resource.data.status == 'queued'
          && request.resource.data.mode in ['dryRun', 'apply']
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['mode', 'status', 'targets', 'updatedAt']);
        allow delete: if false;
      }

      // Custom field definitions (Req 41). Everyone in the event reads them
      // to fill them in; `event.manage` defines them.
      match /fields/{fieldId} {
        allow read: if request.auth != null && isEventMember(eventId);
        allow delete: if request.auth != null && canManageEvent(eventId);
        allow create, update: if request.auth != null
          && canManageEvent(eventId)
          && isNotArchived(eventId)
          && request.resource.data.keys().hasOnly(
              ['label', 'type', 'options', 'required', 'scope', 'visibility', 'order', 'updatedAt'])
          && request.resource.data.label is string
          && request.resource.data.label.size() > 0
          && request.resource.data.label.size() <= 80
          && request.resource.data.type in ['text', 'number', 'date', 'singleChoice', 'multiChoice', 'yesNo']
          && request.resource.data.options is list
          && request.resource.data.options.size() <= 50
          && request.resource.data.required is bool
          && request.resource.data.scope in ['participant', 'group']
          && request.resource.data.visibility in ['standard', 'private']
          && request.resource.data.order is int;
      }

      // People attending, with or without an account, children included (Req
      // 40, 43). Rosters are online and paged. Someone who may only see their
      // own group must list with `groupId in` their group IDs. `uid` (a
      // linked account) and `externalId` (an import's ID) are set by the
      // server only.
      match /participants/{participantId} {
        // A linked person also reads their own record (Req 46), listing it
        // with `uid ==` their ID.
        allow read: if request.auth != null
          && (can(eventId, 'participants.read')
              || inMyGroup(eventId, resource.data.get('groupId', null))
              || resource.data.get('uid', null) == request.auth.uid);

        function validParticipant() {
          let d = request.resource.data;
          let groupId = d.get('groupId', null);
          return d.keys().hasOnly(['name', 'sortName', 'groupId', 'isChild', 'status',
                                   'createdBy', 'createdAt', 'updatedAt', 'uid', 'externalId',
                                   'categoryId', 'fields', 'filterTags', 'imported', 'anonymised'])
            && (d.get('categoryId', null) == null || d.categoryId is string)
            && answersAreValid(d)
            && d.name is string && d.name.size() > 0 && d.name.size() <= 120
            && d.sortName == d.name.lower()
            && d.isChild is bool
            && d.get('status', 'active') in ['active', 'cancelled']
            && (groupId == null
                || (groupId is string
                    && exists(/databases/$(database)/documents/events/$(eventId)/groups/$(groupId))));
        }

        allow create: if request.auth != null
          && isNotArchived(eventId)
          && editsParticipant(eventId, request.resource.data.get('groupId', null))
          && validParticipant()
          && request.resource.data.createdBy == request.auth.uid
          && !('uid' in request.resource.data)
          && !('externalId' in request.resource.data)
          && !('imported' in request.resource.data)
          && !('anonymised' in request.resource.data);

        // Both the group it was in and the one it goes to must be editable,
        // so a linked adult cannot move someone out of their group.
        allow update: if request.auth != null
          && isNotArchived(eventId)
          && editsParticipant(eventId, resource.data.get('groupId', null))
          && editsParticipant(eventId, request.resource.data.get('groupId', null))
          && validParticipant()
          && fieldUnchanged('createdBy')
          && fieldUnchanged('uid')
          && fieldUnchanged('externalId')
          && fieldUnchanged('imported')
          && fieldUnchanged('anonymised');

        allow delete: if request.auth != null
          && isNotArchived(eventId)
          && editsParticipant(eventId, resource.data.get('groupId', null));

        // Private details, such as a birth date (Z-01): read with
        // `participants.readPrivate` or by the group's linked adults, and
        // written by whoever may edit the person. #76 adds private fields.
        match /private/{docId} {
          function person() {
            return get(/databases/$(database)/documents/events/$(eventId)/participants/$(participantId)).data;
          }
          function personGroup() {
            return person().get('groupId', null);
          }

          allow read: if request.auth != null
            && (can(eventId, 'participants.readPrivate')
                || inMyGroup(eventId, personGroup())
                || person().get('uid', null) == request.auth.uid);

          allow write: if request.auth != null
            && isNotArchived(eventId)
            && editsParticipant(eventId, personGroup())
            && (request.resource == null
                || (request.resource.data.keys().hasOnly(['birthDate', 'email', 'fields', 'updatedAt'])
                    && answersAreValid(request.resource.data)
                    && (request.resource.data.get('birthDate', null) == null
                        || (request.resource.data.birthDate is string
                            && request.resource.data.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))));
        }
      }

      // Names and payment handles of people in the event (Req 37), copied
      // from `users/{uid}` by the server. Someone who leaves keeps their name
      // here, without handles, so older messages still show who wrote them.
      match /profiles/{uid} {
        allow read: if request.auth != null && isEventMember(eventId);
        allow write: if false;
      }

      // Expenses subcollection
      match /expenses/{expenseId} {

        // Everyone reads expenses they paid or share in. Reading all of them
        // needs `money.read`, or `expenses.readAll`, which the event's expense
        // access setting puts on member documents (Req 38, Technical
        // Decision 4a). Anyone else must list with `involvedUids
        // array-contains`, because rules refuse a query that could return
        // something they cannot read (Req 38e).
        allow read: if request.auth != null
          && (can(eventId, 'money.read')
              || can(eventId, 'expenses.readAll')
              || resource.data.get('payerId', null) == request.auth.uid
              || request.auth.uid in resource.data.get('involvedUids', []));

        // Expenses are written by the saveExpense and recordSettlement
        // callables, because rules cannot loop over splits to check they add up.
        allow create, update: if false;

        // Delete: the payer, or `money.record`.
        allow delete: if request.auth != null
          && isEventMember(eventId)
          && isNotArchived(eventId)
          && isModuleOn(eventId, 'budget')
          && (resource.data.payerId == request.auth.uid
              || can(eventId, 'money.record'));
      }
    }

    // "My events" (Req 25): a collection-group query on member documents.
    // Anyone may read their own, in any event.
    match /{path=**}/members/{memberId} {
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // Event invites — managed entirely by Cloud Functions via Admin SDK
    // Written only by the server, so nobody can verify themselves.
    match /organizers/{organizerId} {
      allow read: if request.auth != null
        && request.auth.uid == resource.data.ownerId;
      allow write: if false;
    }

    // App config, such as the minimum app version. Read before sign-in, so
    // it is public. Changed only from the console or the Admin SDK.
    match /config/app {
      allow read: if true;
      allow write: if false;
    }

    match /event_invites/{code} {
      allow read, write: if false;
    }

    // Server secrets, such as the key that scrambles match keys (Req 14a).
    match /serverSecrets/{name} {
      allow read, write: if false;
    }

    // Users collection
    //
    // Only the owner reads `users/{uid}` (Req 37). Other people see a name and
    // payment handles only through `events/{eventId}/profiles/{uid}` in an
    // event they share, which the server keeps in step. PII fields (email,
    // providerIds, fcmTokens, preferences, createdAt, updatedAt) live in the
    // users/{uid}/private/profile subdoc.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth.uid == userId;

      match /private/{docId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }

      // Per-user chat read-state. Powers the global inbox unread badges
      // — `users/{uid}/chatReads/{eventId}` carries `lastReadAt`. Only
      // the owning uid may read/write; other users (even co-event
      // members) have no business seeing when someone last opened a
      // chat. ChatRepository.markEventRead / backfillReadStateForExistingEvents
      // / watchLastRead all go through this path.
      match /chatReads/{eventId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }

      // Per-user, per-event push-notification mute state (Phase 5 V3).
      // `users/{uid}/eventMutes/{eventId}` carries `mutedUntil` (ISO-8601
      // UTC string). Self-only: a user's mute choice is private (it
      // would be a privacy leak if co-event members could see who has
      // an event muted). The server-side CF reads this via the Admin
      // SDK and so bypasses these rules.
      match /eventMutes/{eventId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }
    }
  }
}
