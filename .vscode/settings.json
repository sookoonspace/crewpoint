{
  // dart:developer.log() output goes to the Debug Console (not the
  // separate "Flutter" output channel). This is what surfaces our
  // `name: 'profile'` diagnostic logs in the user-resolution path.
  "dart.devToolsLocation": "external",
  "dart.openDevTools": "never",
  "dart.flutterRunAdditionalArgs": [],
  "dart.previewFlutterUiGuides": false,
  "dart.lineLength": 80,

  // Hide build outputs from the file explorer to keep it focused.
  "files.exclude": {
    "**/.dart_tool": true,
    "**/.flutter-plugins": true,
    "**/.flutter-plugins-dependencies": true,
    "**/.packages": true,
    "**/build": true,
    "**/*.g.dart": false,
    "**/*.freezed.dart": false
  },
  "files.watcherExclude": {
    "**/.dart_tool/**": true,
    "**/build/**": true
  },
  "workbench.colorCustomizations": {
    "statusBar.noFolderBackground": "#551913",
    "statusBar.noFolderForeground": "#FEFCFC"
  }
}
