#include "../Release.xcconfig"
#include "../Generated.xcconfig"
PRODUCT_BUNDLE_IDENTIFIER=space.sookoon.crewpoint.app
PRODUCT_NAME=CrewPoint
ASSET_PREFIX=prod
// Universal Links open the app from this Hosting domain (#241).
APP_LINK_HOST=crewpoint.sookoon.space
// Email sign-in links come on this domain (Firebase's default unless
// the project has a custom one; functions/src/account/signInLink.ts).
APP_LINK_AUTH_HOST=crewpoint.sookoon.space
