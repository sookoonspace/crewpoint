#include "Flutter/Debug.xcconfig"
#include "Flutter/Generated.xcconfig"
PRODUCT_BUNDLE_IDENTIFIER=space.sookoon.crewpoint.dev
PRODUCT_NAME=CrewPoint Dev
ASSET_PREFIX=dev
ASSETCATALOG_COMPILER_APPICON_NAME=AppIcon-dev
// Universal Links open the app from this Hosting domain (#241).
APP_LINK_HOST=crewpoint-dev.web.app
// Email sign-in links come on this domain (Firebase's default unless
// the project has a custom one; functions/src/account/signInLink.ts).
APP_LINK_AUTH_HOST=crewpoint-dev.firebaseapp.com
